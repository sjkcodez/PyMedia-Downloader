# ============================================================
# PyMedia Downloader — Git ignore rules
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
.python-version

# ---------- Testing / caching ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.cache/

# ---------- User data (never push) ----------
config.json
logs/
*.log
*.db
*.db-journal
*.db-wal
*.db-shm

# ---------- Downloaded media (never push) ----------
downloads/
!downloads/videos/
!downloads/audio/
!downloads/images/
downloads/videos/*
downloads/audio/*
downloads/images/*
!downloads/videos/.gitkeep
!downloads/audio/.gitkeep
!downloads/images/.gitkeep

# ---------- Temp / scratch ----------
temp/
*.tmp
*.bak
*.swp

# ---------- Cookies / secrets ----------
cookies.txt
cookies-from-browser.txt
*.cookies
.env
.env.*
!.env.example

# ---------- IDE / editors ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.vs/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- Build / deploy artifacts ----------
*.pid
*.seed
*.pid.lock
.vercel/
.netlify/

# ---------- Node (in case you add tooling later) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
